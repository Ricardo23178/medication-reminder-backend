# 本机私密配置模板
# -----------------------------------------------------------------------------
# 用法：把本文件复制为同目录下的 application-local.yml，然后填写真实口令。
#   application-local.yml 已被 .gitignore 忽略，不会进入仓库。
#   该文件通过 application.yml 里的 spring.config.import 自动加载，无需切换 profile。
# -----------------------------------------------------------------------------
spring:
  datasource:
    password: 在这里填本机 MySQL 口令
